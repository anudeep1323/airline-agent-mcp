*
!.gitignore
!README.md
!ARCHITECTURE.md
!requirements-agent.txt
!pytest.ini
!Dockerfile
!.dockerignore
!docker-compose.yml
!render.yaml
!serve_all.py
!.github/
!.github/workflows/
!.github/workflows/*.yml

# the agent stack
!airline_server.py
!passwords.py
!auth.py
!audit.py
!audit_report.py
!agent_core.py
!airline_agent.py
!airline_service.py
!bookings_api.py
!ui.py

# checks, evals, tests
